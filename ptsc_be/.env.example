TZ=Asia/Ho_Chi_Minh
PORT=3156

# SQL Server Configuration
SQLSERVER_HOST=192.168.10.158
SQLSERVER_PORT=1433
SQLSERVER_DATABASE=app_ptsc
SQLSERVER_USER=lifetex
SQLSERVER_PASSWORD=your_password_here

JWT_SECRET=your_jwt_secret_here

# External Services
APP_CONVERT_URL=https://converter-vpstc.lifetex.vn:8080
URL_OFFICE=https://vpstc-document.lifetex.vn/
URL_NESTJS=http://localhost:3156

# Config Keycloak
KEYCLOAK_USE_ENV_ONLY=true
KEYCLOAK_ISSUER=https://keycloak.lifetex.vn/realms/master
KEYCLOAK_BASE_URL=https://keycloak.lifetex.vn
KEYCLOAK_CLIENT_ID=qlqt
KEYCLOAK_CLIENT_SECRET=your_keycloak_secret
KEYCLOAK_REDIRECT_URI=http://localhost:3156/api/auth-keycloak/callback
KEYCLOAK_SCOPE=openid
KEYCLOAK_DOMAIN_FE=http://localhost:8080
REDIRECT_URI_FE=http://localhost:8080
KEYCLOAK_USER_SYNC_SEARCH_FILTERS=email:@ptsc.com.vn

# AI Chat Configuration
ENABLE_AI_SYNC_INCOMING=false
ENABLE_AI_SYNC_OUTGOING=false
COLLABORA_URL=https://vpstc-document.lifetex.vn

# Config Redis
REDIS_HOST=192.168.0.77
REDIS_PORT=6379
REDIS_PASSWORD=your_redis_password
REDIS_DB=0

# Config Sign
URL_KY_TAP_TRUNG=http://localhost:6868
URL_SERVICE_SIGNING=http://localhost:6868/
KSTT_URL=https://administrator.lifetex.vn:356
KSTT_CLIENT_ID=app-vps
KSTT_API_KEY=your_kstt_api_key
CALLBACK_HMAC_SECRET=your_callback_secret

# USB Token
URL_SERVICE_SIGN_USBTOKEN=http://127.0.0.1:8088/

# Google Calendar
GG_REDIRECT_URL=http://localhost:3156/api/google-calendar/oauth2callback/calendar

# Pagination limit
MAX_PAGE_LIMIT=500
DEFAULT_PAGE_LIMIT=20

# Default group code
DEFAULT_GROUP_CODE=defaultGroupCode

# Config cron
DISABLE_CRON=true

# Config OTEL
OTEL_ENABLED=false 
OTEL_SERVICE_NAME=backend-doffice
OTEL_EXPORTER_OTLP_ENDPOINT=http://192.168.0.80:4318
OTEL_DIAG_LOG_LEVEL=INFO

# Config MinIO
CONFIG_MINIO_FROM_ENV=true
ACTIVE_TYPE=minio
MINIO_ACCESS_KEY=admin
MINIO_BUCKET=ptsc
MINIO_ENDPOINT=minio.lifetex.vn:9002
MINIO_SECRET_KEY=your_minio_secret

# Config SMTP Mail
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USER=your_email@ptsc.com.vn
MAIL_PASS=your_mail_app_password
MAIL_SECURE=false
MAIL_FROM=Hệ thống E-Office PTSC
MAIL_ADDRESS_FROM=your_email@ptsc.com.vn

# Config Mobile
SHOW_MOBILE_DOMAIN_INPUT=true
